{
  "name": "pi-learning-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "vitepress dev book --host 127.0.0.1",
    "build": "vitepress build book",
    "preview": "vitepress preview book --host 127.0.0.1",
    "verify:pin": "node scripts/verify-pi-pin.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:scope": "node scripts/verify-public-scope.mjs",
    "check": "pnpm verify:pin && pnpm verify:content && pnpm verify:scope && pnpm build"
  },
  "devDependencies": {
    "@lucide/vue": "1.34.0",
    "vitepress": "1.6.4",
    "vue": "3.5.13"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
